diff --git a/apps/web/nginx.conf b/apps/web/nginx.conf
index 578bd80..8871228 100644
--- a/apps/web/nginx.conf
+++ b/apps/web/nginx.conf
@@ -4,6 +4,14 @@ server {
     root /usr/share/nginx/html;
     index index.html;
 
+    # Compress text responses, including JSON passed through from the API. HTML is always compressed.
+    gzip on;
+    gzip_comp_level 5;
+    gzip_min_length 1024;
+    gzip_proxied any;
+    gzip_vary on;
+    gzip_types text/css text/plain application/javascript application/json image/svg+xml;
+
     # Fingerprinted build assets can be cached aggressively.
     location /assets/ {
         try_files $uri =404;
