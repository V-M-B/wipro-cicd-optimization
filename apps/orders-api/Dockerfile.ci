# syntax=docker/dockerfile:1
# Optimised image build used by ci-optimized.yml (Phase 2). The baseline Dockerfile stays frozen.
# Dependencies are resolved in their own layer keyed only by pom.xml, so source-only changes reuse it.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -B -q dependency:go-offline -DexcludeReactor=true
COPY src ./src
RUN mvn -B -q -DskipTests package

FROM eclipse-temurin:21-jre
RUN groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=build /workspace/target/orders-api-*.jar /app/orders-api.jar
USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/orders-api.jar"]
